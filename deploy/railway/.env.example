# BD Pay edge apps — mock/simulator public demo only
# Applies to each of the 3 Railway services: ops-console, developer-portal, diner-app.
# Client must talk same-origin (/api/mock). Do NOT point NEXT_PUBLIC_BDPAY_API_BASE
# at the raw gateway URL from the browser (CORS + missing FE auth routes).
NEXT_PUBLIC_BDPAY_API_BASE=/api/mock
NEXT_PUBLIC_BDPAY_ENABLE_MOCK=1
BDPAY_ENABLE_MOCK=1
NODE_ENV=production
# REQUIRED when NODE_ENV=production, on ALL 3 apps (ops-console, developer-portal,
# diner-app). Signs the mock/demo session cookies. The apps refuse to start a
# session (error names this var) if it is missing or shorter than 32 characters;
# the public dev fallback secret is only used when NODE_ENV != production.
# Generate a distinct value per service:  openssl rand -hex 32
BDPAY_SESSION_SECRET=
# (BDPAY_MOCK_SESSION_SECRET is still read as a legacy alias when
#  BDPAY_SESSION_SECRET is unset; prefer BDPAY_SESSION_SECRET.)
# Optional explicit mock secrets (defaults kick in when BDPAY_ENABLE_MOCK=1):
# BDPAY_MOCK_TOTP_SECRET_B32=JBSWY3DPEHPK3PXP
# BDPAY_MOCK_OTP_SECRET=bdpay-diner-app-dev-otp-secret-v1
# When using the live BFF instead of mock:
# NEXT_PUBLIC_BDPAY_API_BASE=/api/live
# NEXT_PUBLIC_BDPAY_ENABLE_MOCK=0
# BDPAY_ENABLE_MOCK=0
# BDPAY_GATEWAY_BASE_URL=https://<gateway>.up.railway.app
