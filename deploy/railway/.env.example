# BD Pay edge apps — mock/simulator public demo only
# Client must talk same-origin (/api/mock). Do NOT point NEXT_PUBLIC_BDPAY_API_BASE
# at the raw gateway URL from the browser (CORS + missing FE auth routes).
NEXT_PUBLIC_BDPAY_API_BASE=/api/mock
NEXT_PUBLIC_BDPAY_ENABLE_MOCK=1
BDPAY_ENABLE_MOCK=1
NODE_ENV=production
# Optional explicit secrets (defaults kick in when BDPAY_ENABLE_MOCK=1):
# BDPAY_MOCK_TOTP_SECRET_B32=JBSWY3DPEHPK3PXP
# BDPAY_MOCK_OTP_SECRET=bdpay-diner-app-dev-otp-secret-v1
# BDPAY_MOCK_SESSION_SECRET=replace-me-per-service
# When using the live BFF instead of mock:
# NEXT_PUBLIC_BDPAY_API_BASE=/api/live
# NEXT_PUBLIC_BDPAY_ENABLE_MOCK=0
# BDPAY_ENABLE_MOCK=0
# BDPAY_GATEWAY_BASE_URL=https://<gateway>.up.railway.app
